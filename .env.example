# Core AI provider — OpenAI (runtime chat, vision, quiz, studio, embeddings, voice).
# services/gemini.py is now an OpenAI-backed adapter (name kept for call sites).
OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_API_KEYS=sk-a,sk-b            # optional: multiple keys, rotated on error
OPENAI_MODEL=gpt-5-mini               # text + vision model
OPENAI_EMBED_MODEL=text-embedding-3-small   # RAG embeddings (1536 dims)
OPENAI_TRANSCRIBE_MODEL=whisper-1     # voice-message transcription
OPENAI_REASONING_EFFORT=minimal       # gpt-5 think time: minimal|low|medium|high|off
                                      # 'minimal' = fastest replies (no minute-long spin)
# OPENAI_BASE_URL=                    # optional, for OpenAI-compatible endpoints

# Legacy Gemini key — no longer used at runtime. Only the offline content
# seeders (services/llm_provider.py) can still use it if SEED_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
JWT_SECRET=your_jwt_secret_here
SECRET_KEY=your_secret_key_here_for_session_management
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ilm_ai
ENVIRONMENT=development

# Monitoring
SENTRY_DSN=your_sentry_dsn

# Google OAuth (Optional - for Google login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email verification (Gmail SMTP - generate an App Password at
# https://myaccount.google.com/apppasswords). If unset, verification codes
# are printed to the server console instead of emailed (dev fallback).
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Payment Gateways (Optional - set PAYMENT_TEST_MODE=false for real payments)
PAYMENT_TEST_MODE=true
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_KEY=your_payme_key
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key

# ── Content seeding provider (offline batch jobs only, never a request path) ──
# Now that runtime is OpenAI too, seeding should use OpenAI as well:
#   SEED_PROVIDER=openai
# It reuses OPENAI_API_KEY(S) and OPENAI_MODEL above. (Set SEED_PROVIDER=gemini
# only if you still have a Gemini key you want to use for seeding.)

  "scientific_decisions": [
    {
      "pdf_pages": [
        45,
        46
      ],
      "decision": "Moddiy nuqta vazifaga bog‘liq model; uzoq masofa yagona universal mezon emas. Trayektoriya ko‘rinadigan iz bo‘lishi shart emas; sanoq jismi aytiladi. Oy orbitasi haqidagi soddalashtirish/g‘ildirak va parrakning yerga nisbatan barcha trayektoriyalari haqidagi umumlashtirish savollari yo‘q."
    },
    {
      "pdf_pages": [
        47,
        48,
        49,
        50,
        51
      ],
      "decision": "PDF48 yulduzgacha masofa/farsax tengliklari kabi bahsli sonlar ishlatilmagan. Tekislik skalyar tezlik moduli orqali tushuntiriladi. O‘rtacha tezlik umumiy yo‘l/umumiy vaqt; ikki tezlikning oddiy o‘rtachasi universal emas."
    },
    {
      "pdf_pages": [
        52,
        53,
        54,
        55,
        56,
        57
      ],
      "decision": "g=9,81 N/kg ochiq va izchil. PDF55 ayrim tayyor javoblar 9,8 bilan yaxlitlangan; ular ko‘chirilmagan. Massa kg, kuch N farqlanadi. Tekis tortishda ishqalanish va tortish kuchlari moduli teng; tezlanish vaziyatiga ko‘chirilmaydi. Raqamli lab haqiqiy tajriba emas."
    },
    {
      "pdf_pages": [
        57,
        58,
        59,
        60,
        61
      ],
      "decision": "Bosimda tik kuch va tegish yuzasi; cm²→m² koeffitsiyenti kvadratlanadi. Paskalda tashqi bosim ortishi bilan har xil chuqurlikdagi umumiy bosim tenglashtirilmaydi. Ideal gidravlik pressda ishqalanish/sath farqi e’tiborsizligi aytiladi."
    }
  ],
